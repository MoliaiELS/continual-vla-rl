+def _controllers(env):
+    """Find the same robosuite controllers used by the native LIBERO client."""
+    rob = getattr(env, "env", env)
+    while hasattr(rob, "env"):
+        rob = rob.env
+    result = []
+    for robot in rob.robots:
+        controller = robot.controller
+        result.extend(controller.values() if isinstance(controller, dict) else [controller])
+    if not result:
+        raise RuntimeError("No robosuite controllers found for X-VLA absolute control")
+    return result
+
+
+def _set_controller_delta(env, enabled):
+    for controller in _controllers(env):
+        if not hasattr(controller, "use_delta"):
+            raise RuntimeError("Controller lacks native X-VLA use_delta contract")
+        controller.use_delta = bool(enabled)
+
+
+def _measured_xvla_proprio(env):
+    """Native client: measured controller xyz + first two rotation columns."""
+    controller = _controllers(env)[0]
+    position = np.asarray(controller.ee_pos, dtype=np.float32)
+    rotation = np.asarray(controller.ee_ori_mat, dtype=np.float32)
+    if position.shape != (3,) or rotation.shape != (3, 3):
+        raise RuntimeError("Unexpected controller EEF state shape")
+    proprio = np.zeros(20, dtype=np.float32)
+    proprio[:3] = position
+    proprio[3:6] = rotation[:, 0]
+    proprio[6:9] = rotation[:, 1]
+    return proprio
 
 
