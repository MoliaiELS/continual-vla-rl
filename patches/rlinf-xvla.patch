+    def _step_xvla(self, actions, auto_reset=True, _skip_obs_wrap=False):
+        """Execute only active slots, never post-done or past the horizon.
+
+        Unexecuted chunk suffixes retain observation and have zero reward. The
+        collector receives an explicit execution mask, not fictitious env steps.
+        """
+        if isinstance(actions, torch.Tensor):
+            actions = actions.detach().cpu().numpy()
+        active = (~self._xvla_finished) & (self.elapsed_steps < self.cfg.max_episode_steps)
+        self._xvla_executed = active.copy()
+        indices = np.flatnonzero(active)
+        raw_obs = list(self.current_raw_obs)
+        terminations = np.zeros(self.num_envs, dtype=bool)
+        info_lists = [{} for _ in range(self.num_envs)]
+        if len(indices):
+            stepped_obs, _reward, stepped_done, stepped_info = self.env.step(actions[indices], indices)
+            for slot, index in enumerate(indices):
+                raw_obs[index] = stepped_obs[slot]
+                terminations[index] = stepped_done[slot]
+                info_lists[index] = stepped_info[slot]
+            self._elapsed_steps[indices] += 1
